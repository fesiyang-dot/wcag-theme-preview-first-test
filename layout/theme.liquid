<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{{ shop.name | escape }}</title>
    {{ content_for_header }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body>
    {% section 'header' %}
    <main id="MainContent" class="page">
      {{ content_for_layout }}
    </main>
    {% render 'cart-drawer' %}
  </body>
</html>