<div id="cart-drawer" class="cart-drawer" hidden>
  <div class="cart-drawer__header">
    <h2>Cart</h2>
    <button aria-label="Close cart" data-action="close-cart">
      <svg aria-hidden="true" focusable="false" width="16" height="16" viewBox="0 0 16 16">
        <path d="M3 3l10 10M13 3L3 13" stroke="currentColor" stroke-width="1.5"></path>
      </svg>
    </button>
  </div>
  <p class="cart-drawer__empty">Your cart is empty.</p>
</div>

<script>
  (function () {
    var drawer = document.getElementById('cart-drawer');
    if (!drawer) return;
    document.querySelectorAll('[data-action="open-cart"]').forEach(function (button) {
      button.addEventListener('click', function () {
        drawer.hidden = false;
        drawer.querySelector('[data-action="close-cart"]').focus();
      });
    });
    drawer.addEventListener('click', function (event) {
      if (event.target.closest('[data-action="close-cart"]')) drawer.hidden = true;
    });
  })();
</script>